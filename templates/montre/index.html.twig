{% extends 'base.html.twig' %}

{% block title %}Montre index{% endblock %}

{% block body %}
    <h1>Montre index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for montre in montres %}
            <tr>
                <td>{{ montre.id }}</td>
                <td>{{ montre.nom }}</td>
                <td>{{ montre.description }}</td>
                <td>
                    <a href="{{ path('app_montre_show', {'id': montre.id}) }}">Consulter</a>
                    <a href="{{ path('app_montre_edit', {'id': montre.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucune montre enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}