{% extends 'base.html.twig' %}

{% block title %}Modifier la vitrine | WatchVault{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5 mb-5">

        <div class="mb-4">
            <a href="{{ path('app_vitrine_show', {'id': vitrine.id}) }}"
               class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Retour à la vitrine
            </a>

            <h1 class="fw-bold">Modifier la vitrine</h1>
            <p class="text-muted">
                Modifiez la description, la publication et les montres associées.
            </p>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Informations de la vitrine</h5>
            </div>

            <div class="card-body">
                {{ include('vitrine/_form.html.twig', {
                    'button_label': 'Enregistrer les modifications'
                }) }}
            </div>
        </div>

    </div>
{% endblock %}