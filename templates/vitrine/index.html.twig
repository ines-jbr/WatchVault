{% extends 'base.html.twig' %}

{% block title %}Nos vitrines | WatchVault{% endblock %}

{% block body %}
<div class="container px-4 px-lg-5 mt-5">

    <h1 class="fw-bold mb-4">Nos vitrines</h1>

    <p class="text-muted">
        Découvrez les vitrines de montres publiées.
    </p>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Liste des vitrines</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Identifiant</th>
                            <th>Description</th>
                            <th>Publication</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                    {% for vitrine in vitrines %}

                        {% set isOwner = app.user
                            and vitrine.member
                            and vitrine.member.id == app.user.id
                        %}

                        <tr>
                            <td>{{ vitrine.id }}</td>

                            <td>{{ vitrine.description }}</td>

                            <td>
                                {% if vitrine.publiee %}
                                    <span class="badge bg-success">
                                        Publiée
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        Non publiée
                                    </span>
                                {% endif %}
                            </td>

                            <td class="text-end">

                                <a
                                    href="{{ path('app_vitrine_show', {
                                        'id': vitrine.id
                                    }) }}"
                                    class="btn btn-sm btn-outline-primary"
                                >
                                    Voir
                                </a>

                                {% if isOwner %}
                                    <a
                                        href="{{ path('app_vitrine_edit', {
                                            'id': vitrine.id
                                        }) }}"
                                        class="btn btn-sm btn-outline-secondary"
                                    >
                                        Modifier
                                    </a>
                                {% endif %}

                            </td>
                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                Aucune vitrine publiée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
{% endblock %}