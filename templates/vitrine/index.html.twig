{% extends 'base.html.twig' %}

{% block title %}Nos vitrines | WatchVault{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold">Nos vitrines</h1>
                <p class="text-muted">Découvrez et gérez vos vitrines de montres.</p>
            </div>

            <a href="{{ path('app_vitrine_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Créer une vitrine
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Liste des vitrines</h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Identifiant</th>
                                <th>Description</th>
                                <th>Publication</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for vitrine in vitrines %}
                            <tr>
                                <td>{{ vitrine.id }}</td>
                                <td>{{ vitrine.description }}</td>

                                <td>
                                    {% if vitrine.publiee %}
                                        <span class="badge bg-success">Publiée</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Non publiée</span>
                                    {% endif %}
                                </td>

                                <td class="text-end">
                                    <a
                                        href="{{ path('app_vitrine_show', {'id': vitrine.id}) }}"
                                        class="btn btn-sm btn-outline-primary"
                                    >
                                        <i class="bi bi-eye"></i> Voir
                                    </a>

                                    <a
                                        href="{{ path('app_vitrine_edit', {'id': vitrine.id}) }}"
                                        class="btn btn-sm btn-outline-secondary"
                                    >
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <p class="text-muted mb-3">
                                        Aucune vitrine n'a encore été créée.
                                    </p>

                                    <a href="{{ path('app_vitrine_new') }}"
                                       class="btn btn-primary">
                                        Créer ma première vitrine
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
{% endblock %}