{% extends 'base.html.twig' %}

{% block title %}Montre n°{{ montre.id }} | WatchVault{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold">Détails de la montre</h1>
                <p class="text-muted">
                    Consultez les informations et la photo de cette montre.
                </p>
            </div>

            <a href="{{ path('app_vitrine_show', {'id': vitrine.id}) }}"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Retour à la vitrine
            </a>
        </div>

        <div class="card shadow-sm mb-5">

            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-watch"></i>
                    Informations de la montre
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    {# Photo de la montre #}
                    <div class="col-md-5 mb-4">

                        {% if montre.imageName %}

                            <img
                                src="{{ vich_uploader_asset(montre, 'imageFile') }}"
                                alt="Photo de {{ montre.nom }}"
                                class="img-fluid rounded shadow-sm"
                                style="width: 100%; max-height: 350px; object-fit: contain;"
                            >

                        {% else %}

                            <div class="d-flex align-items-center justify-content-center bg-light rounded"
                                 style="height: 300px;">

                                <p class="text-muted">
                                    <i class="bi bi-image"></i>
                                    Aucune image disponible
                                </p>

                            </div>

                        {% endif %}

                    </div>

                    {# Informations générales #}
                    <div class="col-md-7">

                        <table class="table table-striped">
                            <tbody>

                                <tr>
                                    <th>Identifiant</th>
                                    <td>{{ montre.id }}</td>
                                </tr>

                                <tr>
                                    <th>Nom</th>
                                    <td>{{ montre.nom }}</td>
                                </tr>

                                <tr>
                                    <th>Description</th>
                                    <td>{{ montre.description }}</td>
                                </tr>

                            </tbody>
                        </table>

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <a href="{{ path('app_vitrine_show', {'id': vitrine.id}) }}"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Retour à la vitrine

                </a>

            </div>

        </div>

    </div>
{% endblock %}