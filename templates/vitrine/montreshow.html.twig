{% extends 'base.html.twig' %}

{% block title %}Montre n°{{ montre.id }}{% endblock %}

{% block body %}
    <h1>Montre</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ montre.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ montre.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ montre.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_vitrine_show', {'id': vitrine.id}) }}">
        Retour à la vitrine
    </a>
{% endblock %}