{% extends 'base.html.twig' %}

{% block title %}Créer une vitrine | WatchVault{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5 mb-5">

        <div class="mb-4">
            <a href="{{ path('app_vitrine_index') }}"
               class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> Retour aux vitrines
            </a>

            <h1 class="fw-bold">Créer une vitrine</h1>
            <p class="text-muted">
                Créez une vitrine et choisissez les montres que vous souhaitez y présenter.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Informations de la vitrine</h5>
            </div>

            <div class="card-body">
                {{ include('vitrine/_form.html.twig') }}
            </div>
        </div>

    </div>
{% endblock %}