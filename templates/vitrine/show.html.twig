{% extends 'base.html.twig' %}

{% block title %}Vitrine {{ vitrine.id }} | WatchVault{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold">Détail de la vitrine</h1>
                <p class="text-muted">Consultez les informations et les montres associées.</p>
            </div>

            <a href="{{ path('app_vitrine_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour aux vitrines
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Informations générales</h5>
            </div>

            <div class="card-body">
                <p><strong>Identifiant :</strong> {{ vitrine.id }}</p>
                <p><strong>Description :</strong> {{ vitrine.description }}</p>

                <p class="mb-0">
                    <strong>Publication :</strong>
                    {% if vitrine.publiee %}
                        <span class="badge bg-success">Publiée</span>
                    {% else %}
                        <span class="badge bg-secondary">Non publiée</span>
                    {% endif %}
                </p>
            </div>

            <div class="card-footer bg-white">
                <a href="{{ path('app_vitrine_edit', {'id': vitrine.id}) }}"
                   class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Modifier la vitrine
                </a>

                {{ include('vitrine/_delete_form.html.twig') }}
            </div>
        </div>

        <div class="card shadow-sm mb-5">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-watch"></i> Montres associées
                </h5>
            </div>

            <div class="card-body">
                {% if vitrine.montres is not empty %}
                    <div class="row">
                        {% for montre in vitrine.montres %}
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <a href="{{ path('app_vitrine_montre_show', {
                                                'vitrine_id': vitrine.id,
                                                'montre_id': montre.id
                                            }) }}" class="text-decoration-none">
                                                {{ montre.nom }}
                                            </a>
                                        </h5>
                                        <p class="card-text text-muted">
                                            {{ montre.description }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted mb-0">
                        Aucune montre n'est associée à cette vitrine.
                    </p>
                {% endif %}
            </div>
        </div>

    </div>
{% endblock %}