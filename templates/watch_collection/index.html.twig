{% extends 'base.html.twig' %}

{% block title %}Liste des collections - WatchVault{% endblock %}

{% block body %}

<div class="container mt-5 mb-5">

    <h1 class="mb-4">Liste des collections</h1>

    {% if watchCollections is not empty %}

        <div class="row">

            {% for watchCollection in watchCollections %}

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                {{ watchCollection.description }}
                            </h5>

                            <p class="card-text text-muted">
                                Découvrez les montres de cette collection.
                            </p>

                            <a href="{{ path('watch_collection_show', {
                                'id': watchCollection.id
                            }) }}" class="btn btn-primary">

                                Voir la collection

                            </a>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% else %}

        <div class="alert alert-info">
            Aucune collection disponible.
        </div>

    {% endif %}

</div>

{% endblock %}