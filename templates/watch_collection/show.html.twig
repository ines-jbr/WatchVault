{% extends 'base.html.twig' %}

{% block title %}Collection n°{{ watchCollection.id }}{% endblock %}

{% block body %}
    <h1>Collection</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ watchCollection.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ watchCollection.description }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Montres</h2>

    <a href="{{ path('app_montre_new', {'id': watchCollection.id}) }}"
       class="btn btn-primary mb-3">
        Ajouter une montre
    </a>

    <ul>
        {% for montre in watchCollection.montres %}
            <li>
                <a href="{{ path('app_montre_show', {'id': montre.id}) }}">
                    {{ montre.nom }}
                </a>
            </li>
        {% else %}
            <li>Aucune montre dans cette collection.</li>
        {% endfor %}
    </ul>

    {% if watchCollection.member is defined and watchCollection.member is not null %}
        <a href="{{ path('app_member_show', {'id': watchCollection.member.id}) }}"
           class="btn btn-secondary">
            Retour à la fiche du membre
        </a>
    {% else %}
        <p class="text-muted">
            Aucun membre n'est associé à cette collection.
        </p>
    {% endif %}

    <a href="{{ path('watch_collection_list') }}" class="btn btn-secondary">
        Retour à la liste des collections
    </a>
{% endblock %}